# Ambiente de execução: development | test | production
NODE_ENV=development
# Porta HTTP em que a API escuta (no Render, a plataforma define sozinha)
PORT=3000

# Banco de dados PostgreSQL (local: docker compose; produção: Neon)
DB_HOST=localhost
# 5433 no local: evita conflito com um Postgres instalado direto no sistema (que usa a 5432)
DB_PORT=5433
DB_USER=medclinic
DB_PASSWORD=troque-esta-senha
DB_NAME=medclinic
# true em produção (Neon exige SSL); false no Postgres local do docker compose
DB_SSL=false

# Segredo que assina os tokens: texto aleatório com 32+ caracteres
JWT_SECRET=gere-um-texto-aleatorio-com-pelo-menos-32-caracteres
# Validade do accessToken, em segundos (3600 = 1 hora)
JWT_EXPIRES_IN=3600

# Primeiro administrador, criado pela migration de seed
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@medclinic.com
ADMIN_PASSWORD=troque-esta-senha
